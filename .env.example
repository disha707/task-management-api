# Required — PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskdb

# Required — must be at least 16 characters; use a strong random value in production
JWT_SECRET=replace-with-a-strong-secret

# Optional — token lifetime (default: 7d)
JWT_EXPIRES_IN=7d

# Optional — one of: development | staging | production | test (default: development)
NODE_ENV=development

# Optional — HTTP port (default: 3000)
PORT=3000
